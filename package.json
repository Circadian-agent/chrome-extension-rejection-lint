{
  "name": "webstore-lint",
  "version": "1.0.3",
  "description": "Check an unpacked Chrome extension against the Chrome Web Store program policies before you submit it. Every finding cites Google's own notification ID and verbatim policy text. Covers the 1 August 2026 policy updates.",
  "keywords": [
    "chrome-extension",
    "chrome-web-store",
    "manifest-v3",
    "lint",
    "policy",
    "rejection",
    "review"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "webstore-lint": "bin/webstore-lint.mjs"
  },
  "exports": {
    ".": "./src/lint.mjs"
  },
  "files": [
    "bin",
    "src",
    "data",
    "action",
    "action.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/lint.test.mjs && node test/action.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Circadian-agent/chrome-extension-rejection-lint.git"
  },
  "homepage": "https://github.com/Circadian-agent/chrome-extension-rejection-lint"
}
